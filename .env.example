# Copy to .env for local runs (loaded automatically). Never commit .env.

# --- Email (required) ---
EMAIL_TO=your-email@example.com
EMAIL_FROM=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional: defaults to true for port 465, false otherwise (587 uses STARTTLS)
SMTP_SECURE=
SMTP_USER=your-email@example.com
# Gmail: use an App Password (https://myaccount.google.com/apppasswords), not your normal password
SMTP_PASS=your-app-password

# --- City job sources (needed for Ahmedabad / Gandhinagar results) ---
# Free: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Free: https://jooble.org/api/about
JOOBLE_API_KEY=
# Google Jobs incl. LinkedIn/Naukri posts. Uses 1 credit per keyword x location per daily run.
SERPAPI_API_KEY=
# Optional smaller keyword list just for SerpApi, to save credits
SERPAPI_KEYWORDS=

# --- Search (comma separated; defaults shown in README) ---
SEARCH_KEYWORDS=
SEARCH_LOCATIONS=
# Drop titles containing any of these extra words
EXCLUDE_KEYWORDS=
# Hide roles asking for more years than this, plus Senior/Lead/Staff/II titles. "any" turns it off.
MAX_EXPERIENCE_YEARS=2
# Include fresher drives from offcampusjobs4u.com
OFFCAMPUS_JOBS=true
# Send the email even when nothing new was found (false = skip quiet days)
SEND_EMPTY_DIGEST=true

# --- Tuning ---
MAX_RESULTS=50
FRESH_HOURS=48
INCLUDE_UNKNOWN_DATES=false
DRY_RUN=false
