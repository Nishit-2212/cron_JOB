# Required for email delivery
EMAIL_TO=your-email@example.com
EMAIL_FROM=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Optional search providers
# SerpApi can return Google Jobs results, including LinkedIn postings where available.
SERPAPI_API_KEY=

# Optional job APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Optional tuning
MAX_RESULTS=50
FRESH_HOURS=36
INCLUDE_UNKNOWN_DATES=false
DRY_RUN=false
